NODE_ENV=development

# AWS (credenciales dummy requeridas por el SDK aunque DynamoDB sea local)
AWS_ACCOUNT_ID=123456789012
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1

# Auth
JWT_SECRET=jwt_secret

# Stage
STAGE=docker

# Database
DYNAMODB_ENDPOINT=http://ecommerce-localstack:4566
USERS_TABLE=users-service-db

REGION=us-east-1

# SQS
USER_CREATED_QUEUE_URL=http://ecommerce-localstack:4566/000000000000/user-created-queue
